use storage;
use std.args;
use std.io;
use std.mem;
use std.fs;

@effects(io.write)
func report_error(message: read u8[], status: i32) -> i32 {
    match (io.write_stderr(read message)) {
        case Result.ok(let count: usize) {
            return status;
        }
        case Result.err(let error: io.Error) {
            return 74;
        }
    }
}

@effects(process.args, io.write, fs.open, fs.close, fs.write, fs.sync)
func save_argument(path: edit u8[]) -> i32 {
    match (args.read_into(0, edit path)) {
        case Result.ok(let length: usize) {
            match (storage.save(read path[0..length])) {
                case Result.ok() {
                    io.println(read "file-report: report created");
                    return 0;
                }
                case Result.err(let error: fs.Error) {
                    return report_error(read "file-report: cannot save report; output may be incomplete\n", 74);
                }
            }
        }
        case Result.err(let error: args.Error) {
            return report_error(read "file-report: output path is unavailable or exceeds 4096 bytes\n", 64);
        }
    }
}

@effects(memory, process.args, io.write, fs.open, fs.close, fs.write, fs.sync)
func main() -> i32 {
    match (args.count()) {
        case Result.ok(let count: usize) {
            if (count != 1) {
                return report_error(read "usage: file-report OUTPUT\n", 64);
            }
        }
        case Result.err(let error: args.Error) {
            return report_error(read "file-report: process arguments are unavailable\n", 71);
        }
    }

    match (mem.bytes(4096, 4096)) {
        case Result.ok(let allocation: Buffer<u8>) {
            var path: Buffer<u8> = move(allocation);
            return save_argument(edit path);
        }
        case Result.err(let error: mem.Error) {
            return report_error(read "file-report: cannot allocate path buffer\n", 71);
        }
    }
}
