use std.args;
use std.fs;
use std.io;
use std.mem;

func report(message: read u8[], status: i32) -> i32 {
    match (io.write_stderr(read message)) {
        case Result.ok(let count: usize) { return status; }
        case Result.err(let error: io.Error) { return 74; }
    }
}

func copy_stdout(file: edit fs.File, buffer: edit u8[]) -> i32 {
    while (true) {
        match (fs.read_into(edit file, edit buffer)) {
            case Result.ok(let count: usize) {
                if (count == 0) { return 0; }
                match (io.write(read buffer[0..count])) {
                    case Result.ok(let written: usize) {}
                    case Result.err(let error: io.Error) {
                        return report(read "filecat: cannot write standard output\n", 74);
                    }
                }
            }
            case Result.err(let error: fs.Error) {
                return report(read "filecat: cannot read input file\n", 74);
            }
        }
    }
    return 70;
}

func run(file: fs.File, buffer: edit u8[]) -> i32 {
    var active: fs.File = move(file);
    let status: i32 = copy_stdout(edit active, edit buffer);
    match (fs.close(move(active))) {
        case Result.ok() { return status; }
        case Result.err(let error: fs.Error) {
            if (status != 0) { return status; }
            return report(read "filecat: cannot close input file\n", 74);
        }
    }
}

func open_input(buffer: edit u8[]) -> i32 {
    match (args.read_into(0, edit buffer)) {
        case Result.ok(let length: usize) {
            match (fs.open_read(read buffer[0..length])) {
                case Result.ok(let file: fs.File) { return run(move(file), edit buffer); }
                case Result.err(let error: fs.Error) {
                    return report(read "filecat: cannot open a regular input file\n", 66);
                }
            }
        }
        case Result.err(let error: args.Error) {
            return report(read "filecat: argument is unavailable or exceeds 4096 bytes\n", 64);
        }
    }
}

func main() -> i32 {
    match (args.count()) {
        case Result.ok(let count: usize) {
            if (count != 1) { return report(read "usage: filecat PATH\n", 64); }
        }
        case Result.err(let error: args.Error) {
            return report(read "filecat: process arguments are unavailable\n", 71);
        }
    }
    match (mem.bytes(4096, 4096)) {
        case Result.ok(let allocation: Buffer<u8>) {
            var buffer: Buffer<u8> = move(allocation);
            return open_input(edit buffer);
        }
        case Result.err(let error: mem.Error) {
            return report(read "filecat: cannot allocate input buffer\n", 71);
        }
    }
}
