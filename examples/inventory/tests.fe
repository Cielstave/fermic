use "src/errors.fe";
use "src/model.fe";
use "src/parser.fe";

func same(left: read model.State, right: read model.State) -> bool {
    for (var index: usize = 0; index < left.items.len; index += 1) {
        if (left.items[index].active != right.items[index].active ||
            left.items[index].id != right.items[index].id ||
            left.items[index].quantity != right.items[index].quantity ||
            left.items[index].price != right.items[index].price ||
            left.items[index].name_length != right.items[index].name_length) { return false; }
        for (var byte: usize = 0; byte < 48; byte += 1) {
            if (left.items[index].name[byte] != right.items[index].name[byte]) { return false; }
        }
    }
    return true;
}

func apply(state: edit model.State, bytes: read u8[]) -> Result<void, errors.Error> {
    let command: model.Command = try(parser.decode(read bytes));
    return model.apply(edit state, read command);
}

func lifecycle() -> Result<bool, errors.Error> {
    var state: model.State = model.initial();
    try(apply(edit state, read "ITEM 7 8 1250 Café beans"));
    try(apply(edit state, read "IN 7 4"));
    try(apply(edit state, read "OUT 7 12"));
    try(apply(edit state, read "PRICE 7 900"));
    if (state.items[0].quantity != 0 || state.items[0].price != 900 ||
        state.items[0].name_length != 11 || !model.valid(read state)) { return Result.ok(false); }
    try(apply(edit state, read "DROP 7"));
    try(apply(edit state, read "ITEM 8 1 0 Valve 😀"));
    return Result.ok(state.items[0].id == 8 && model.valid(read state));
}

func test_lifecycle() -> bool {
    match (lifecycle()) {
        case Result.ok(let valid: bool) { return valid; }
        case Result.err(let error: errors.Error) { return false; }
    }
}

func rejected(state: edit model.State, before: read model.State, bytes: read u8[], expected: errors.Error) -> bool {
    match (apply(edit state, read bytes)) {
        case Result.ok() { return false; }
        case Result.err(let error: errors.Error) {
            return error == expected && same(read state, read before) && model.valid(read state);
        }
    }
}

func rejection_checks() -> Result<bool, errors.Error> {
    var state: model.State = model.initial();
    try(apply(edit state, read "ITEM 7 1000000 1000000 Steel bolts"));
    let before: model.State = copy(state);
    return Result.ok(
        rejected(edit state, read before, read "ITEM 7 0 0 Other", errors.Error.duplicate) &&
        rejected(edit state, read before, read "IN 7 1", errors.Error.quantity) &&
        rejected(edit state, read before, read "OUT 9 1", errors.Error.missing) &&
        rejected(edit state, read before, read "DROP 7", errors.Error.not_empty) &&
        rejected(edit state, read before, read "OUT 7 1000001", errors.Error.number) &&
        rejected(edit state, read before, read "PRICE 7 -1", errors.Error.number));
}

func test_rejections_preserve_state() -> bool {
    match (rejection_checks()) {
        case Result.ok(let valid: bool) { return valid; }
        case Result.err(let error: errors.Error) { return false; }
    }
}

func invalid(bytes: read u8[]) -> bool {
    match (parser.decode(read bytes)) {
        case Result.ok(let command: model.Command) { return false; }
        case Result.err(let error: errors.Error) { return true; }
    }
}

func test_parser_boundaries() -> bool {
    let malformed: u8[15] = [73, 84, 69, 77, 32, 49, 32, 48, 32, 48, 32, 240, 159, 152, 255];
    let nul: u8[14] = [73, 84, 69, 77, 32, 49, 32, 48, 32, 48, 32, 65, 0, 66];
    return invalid(read "") && invalid(read "ITEM") && invalid(read "IN 1") &&
           invalid(read "IN  1 0") && invalid(read "IN 1 0 ") && invalid(read "DROP 1 0") &&
           invalid(read "ITEM 1 0 0 ") && invalid(read "ITEM 1 0 0  name") &&
           invalid(read "ITEM 1 0 0 name ") && invalid(read "ITEM 1 0 0 name\r") &&
           invalid(read malformed) && invalid(read nul);
}

func capacity_checks() -> Result<bool, errors.Error> {
    var state: model.State = model.initial();
    var command: model.Command = try(parser.decode(read "ITEM 1 0 0 Part"));
    for (var index: usize = 0; index < 64; index += 1) {
        command.id = index + 1;
        try(model.apply(edit state, read command));
    }
    let before: model.State = copy(state);
    if (!rejected(edit state, read before, read "ITEM 65 0 0 Part", errors.Error.capacity)) {
        return Result.ok(false);
    }
    try(apply(edit state, read "DROP 32"));
    try(apply(edit state, read "ITEM 65 1 0 Part"));
    return Result.ok(state.items[31].id == 65 && model.valid(read state));
}

func test_capacity_reuse() -> bool {
    match (capacity_checks()) {
        case Result.ok(let valid: bool) { return valid; }
        case Result.err(let error: errors.Error) { return false; }
    }
}
