// DESIGN ONLY: future Fermi syntax; not accepted by the current compiler.
use backend;
use backend.runtime;
use backend.telemetry;
use http.server;
use platform.app;
use platform.config;

func start() -> Result<void, backend.Failure> {
    let settings: config.Settings = try config.load();
    let application: app.App = try app.open(read settings);
    let context: backend.Context = try runtime.process_context();
    // Registers internal health routes, handles signals, drains for ten seconds.
    return runtime.api(read application, read settings, read context,
        server.serve, app.ready, 10_000);
}

func main() -> i32 {
    match (start()) {
        case Result.ok { return 0; }
        case Result.err(let failure: backend.Failure) {
            telemetry.failure_code("api_stopped", failure.code);
            return 1;
        }
    }
}
