// DESIGN ONLY: future Fermi syntax; not accepted by the current compiler.
use backend;
use backend.queue;
use backend.time;
use platform.app;

pub func run(application: read app.App, context: read backend.Context)
    -> Result<void, backend.Failure> {
    while (!backend.cancelled(read context)) {
        // Bounded batches and database timeouts; safe across multiple replicas.
        try queue.reap_exhausted(read application.database, 500, 5);
        try queue.purge_expired_keys(read application.database, 500);
        try queue.purge_terminal_jobs(read application.database, 500, 604_800);
        try time.wait(read context, 30_000);
    }
    return Result.ok();
}
