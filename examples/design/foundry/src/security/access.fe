// DESIGN ONLY: future Fermi syntax; not accepted by the current compiler.
use backend;
use backend.database;
use backend.http;
use backend.identity;
use backend.limits;
use platform.app;

pub struct Principal {
    tenant: backend.Id;
    subject: backend.Id;
}

pub func authorize(application: read app.App, request: read http.Request,
    tenant: backend.Id) -> Result<Principal, backend.Failure> {
    let token: identity.SecretToken = try http.bearer_token(read request);
    let claims: identity.Claims = try identity.verify(read application.identity, read token);
    let allowed: bool = try database.exists(read application.database,
        "SELECT 1 FROM memberships WHERE tenant_id = $1 AND subject_id = $2 AND active = true",
        database.params(tenant, claims.subject));
    if (!allowed) {
        return Result.err(backend.failure(backend.Code.forbidden));
    }
    try limits.admit(read application.limiter, tenant, 120, 60);
    return Result.ok(Principal { tenant: tenant, subject: claims.subject });
}
