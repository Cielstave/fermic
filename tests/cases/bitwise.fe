@budget(work = 100, heap = 0)
export func mask8(a: u8, b: u8) -> u8 { return a & b; }
export func merge8(a: u8, b: u8) -> u8 { return a | b; }
export func xor8(a: u8, b: u8) -> u8 { return a ^ b; }
export func invert8(a: u8) -> u8 { return ~a; }
export func left8(a: u8, count: usize) -> u8 { return a << count; }
export func right8(a: u8, count: usize) -> u8 { return a >> count; }
export func mask32(a: u32, b: u32) -> u32 { return a & b; }
export func merge32(a: u32, b: u32) -> u32 { return a | b; }
export func xor32(a: u32, b: u32) -> u32 { return a ^ b; }
export func invert32(a: u32) -> u32 { return ~a; }
export func left32(a: u32, count: usize) -> u32 { return a << count; }
export func right32(a: u32, count: usize) -> u32 { return a >> count; }
export func mask_size(a: usize, b: usize) -> usize { return a & b; }
export func merge_size(a: usize, b: usize) -> usize { return a | b; }
export func xor_size(a: usize, b: usize) -> usize { return a ^ b; }
export func invert_size(a: usize) -> usize { return ~a; }
export func left_size(a: usize, count: usize) -> usize { return a << count; }
export func right_size(a: usize, count: usize) -> usize { return a >> count; }
export func precedence() -> bool {
    let a: u32 = 1 | 2 ^ 3 & 7;
    let b: u32 = 1 + 2 << 3;
    let c: u32 = 64 >> 2 + 1;
    let d: bool = true || false && false;
    let e: bool = a << 2 < 5;
    let f: u8 = ~1 & 3;
    // Equality binds more tightly than bitwise AND: parenthesize the mask.
    return a == 1 && b == 24 && c == 8 && d && e && f == 2;
}
func next(output: edit u8[], value: u8) -> u8 {
    output[0] = output[0] * 10 + value;
    return value;
}
func count(output: edit u8[]) -> usize {
    output[0] = output[0] * 10 + 2;
    return 1;
}
export func evaluation(output: edit u8[]) -> u8 {
    let pair: u8 = next(edit output, 1) | next(edit output, 2);
    output[1] = output[0];
    output[0] = 0;
    let shift: u8 = next(edit output, 3) << count(edit output);
    return pair ^ shift;
}
export func partial(output: edit u8[], count: usize) -> u8 {
    output[0] = 7;
    return output[0] << count;
}
