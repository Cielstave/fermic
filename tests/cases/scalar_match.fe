use std.mem;

@effects()
@budget(work = 100, heap = 0)
func signed_code(value: i8) -> u8 {
    match (value) {
        case -128 { return 10; }
        case -1 { return 20; }
        case 0 { return 30; }
        case 127 { return 40; }
        case _ { return 50; }
    }
}

@effects()
func generic_code<T: integer>(value: T) -> u8 {
    match (value) {
        case 0 { return 1; }
        case 1 { return 2; }
        case _ { return 3; }
    }
}

func test_all_signed_bytes() -> bool {
    for (var number: i16 = -128; number < 128; number += 1) {
        match (narrow<i8>(number)) {
            case Result.ok(let value: i8) {
                var expected: u8 = 50;
                if (number == -128) { expected = 10; }
                if (number == -1) { expected = 20; }
                if (number == 0) { expected = 30; }
                if (number == 127) { expected = 40; }
                if (signed_code(value) != expected) { return false; }
            }
            case Result.err(let error: CastError) { return false; }
        }
    }
    return true;
}

func test_integer_widths() -> bool {
    return generic_code<u8>(0) == 1
        && generic_code<i8>(-1) == 3
        && generic_code<u16>(1) == 2
        && generic_code<i16>(-32768) == 3
        && generic_code<u32>(4294967295) == 3
        && generic_code<i32>(0) == 1
        && generic_code<u64>(18446744073709551615) == 3
        && generic_code<i64>(-9223372036854775808) == 3
        && generic_code<usize>(1) == 2;
}

func unsigned_code(value: u64) -> u8 {
    match (value) {
        case 0 { return 1; }
        case 9223372036854775808 { return 2; }
        case 18446744073709551615 { return 3; }
        case _ { return 4; }
    }
}

func signed_wide_code(value: i64) -> u8 {
    match (value) {
        case -9223372036854775808 { return 1; }
        case 9223372036854775807 { return 2; }
        case -1 { return 3; }
        case _ { return 4; }
    }
}

func test_wide_extrema() -> bool {
    return unsigned_code(0) == 1
        && unsigned_code(9223372036854775808) == 2
        && unsigned_code(18446744073709551615) == 3
        && unsigned_code(7) == 4
        && signed_wide_code(-9223372036854775808) == 1
        && signed_wide_code(9223372036854775807) == 2
        && signed_wide_code(-1) == 3
        && signed_wide_code(7) == 4;
}

func next_value(counter: edit u8[]) -> u8 {
    let value: u8 = counter[0];
    counter[0] += 1;
    return value;
}

func test_subject_once() -> bool {
    var counter: u8[1] = [0];
    match (next_value(edit counter)) {
        case 0 {}
        case 1 { return false; }
        case _ { return false; }
    }
    return counter[0] == 1;
}

func boolean_code(value: bool) -> u8 {
    var result: u8;
    match (value) {
        case true { result = 7; }
        case false { result = 9; }
    }
    return result;
}

func test_boolean_join() -> bool {
    return boolean_code(true) == 7 && boolean_code(false) == 9;
}

func test_wildcard_only() -> bool {
    match (false) {
        case _ { return true; }
    }
}

struct Packet {
    payload: Buffer<u8>;
    code: u8;
}

func make_packet() -> Result<Packet, mem.Error> {
    return Result.ok(Packet(payload = try(mem.bytes(4, 4)), code = 7));
}

func temporary_code() -> Result<u8, mem.Error> {
    match (try(make_packet()).code) {
        case 7 { return Result.ok(1); }
        case _ { return Result.ok(0); }
    }
}

func test_temporary_owner() -> bool {
    match (temporary_code()) {
        case Result.ok(let code: u8) { return code == 1; }
        case Result.err(let error: mem.Error) { return false; }
    }
}

func loop_resources() -> Result<usize, mem.Error> {
    var total: usize = 0;
    for (var index: usize = 0; index < 8; index += 1) {
        let buffer: Buffer<u8> = try(mem.bytes(4, 4));
        match (index % 3) {
            case 0 { continue; }
            case 1 { total += buffer.len; }
            case _ { break; }
        }
    }
    return Result.ok(total);
}

func test_loop_cleanup() -> bool {
    match (loop_resources()) {
        case Result.ok(let total: usize) { return total == 4; }
        case Result.err(let error: mem.Error) { return false; }
    }
}
