enum Failure { rejected, }

func index(calls: edit i32[]) -> usize {
    calls[0] += 1;
    return 0;
}

export func quotient(value: i32, divisor: i32) -> i32 {
    var result: i32 = value;
    result /= divisor;
    return result;
}

export func remainder(value: i32, divisor: i32) -> i32 {
    var result: i32 = value;
    result %= divisor;
    return result;
}

export func indexed(values: edit i32[], calls: edit i32[], divisor: i32) -> void {
    values[index(edit calls)] /= divisor;
    values[index(edit calls)] %= 3;
}

export func guarded(enabled: bool, divisor: i32) -> bool {
    return enabled && 12 / divisor > 1 || !enabled;
}

func choose(accept: bool) -> Result<i32, Failure> {
    if (accept) { return Result.ok(4); }
    else { return Result.err(Failure.rejected); }
}

export func branches(accept: bool, count: usize) -> i32 {
    var total: i32;
    match (choose(accept)) {
        case Result.err(let error: Failure) { total = -4; }
        case Result.ok(let value: i32) { total = value; }
    }
    for (var i: usize = 0; i < count; i += 1) {
        var j: usize = 0;
        while (j < 2) { total += 1; j += 1; }
    }
    if (total < 0) { return -1; }
    else if (total == 0) { return 0; }
    else { return total; }
}

@budget(work = 100, heap = 0)
export func bounded(value: usize, divisor: usize) -> usize {
    var count: usize = value;
    count /= divisor;
    count %= 4;
    return count;
}

export func signed_limits(small: i16, medium: i32, large: i64) -> bool {
    return -32768 <= small && small <= +32767 &&
           -2147483648 <= medium && medium <= +2147483647 &&
           -9223372036854775808 <= large && large <= +9223372036854775807;
}

func observe(calls: edit i32[], value: i32) -> i32 {
    calls[0] += 1;
    return value;
}

export func negative_first(calls: edit i32[], value: i32) -> bool {
    return -1 < observe(edit calls, value);
}

export func literal_overflow(value: i16) -> bool {
    return -(-32768) == value;
}

export func complement(value: u8) -> bool {
    return ~0 == value;
}
