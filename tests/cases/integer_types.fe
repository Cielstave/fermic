    var value: u16 = left;
    value += right;
    return value;
}

export func subtract_u16(left: u16, right: u16) -> u16 {
    var value: u16 = left;
    value -= right;
    return value;
}

export func multiply_u16(left: u16, right: u16) -> u16 {
    var value: u16 = left;
    value *= right;
    return value;
}

export func divide_u16(left: u16, right: u16) -> u16 {
    var value: u16 = left;
    value /= right;
    return value;
}

export func remainder_u16(left: u16, right: u16) -> u16 {
    var value: u16 = left;
    value %= right;
    return value;
}

export func add_u64(left: u64, right: u64) -> u64 {
    var value: u64 = left;
    value += right;
    return value;
}

export func subtract_u64(left: u64, right: u64) -> u64 {
    var value: u64 = left;
